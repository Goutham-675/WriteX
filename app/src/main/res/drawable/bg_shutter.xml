<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- glow halo -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="14dp"
                android:color="#40FFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- outer ring -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="#FFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- inner dot -->
    <item
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp"
        android:top="10dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>